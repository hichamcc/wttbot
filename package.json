{
  "name": "wtt-bot-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "WTTsystem WhatsApp assistant for drivers (Baileys + Gemini, read-only on the WTT database)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
