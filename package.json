    "ask": "node scripts/ask.js",
    "models": "node scripts/list-models.js"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "baileys": "7.0.0-rc14",
    "dotenv": "18.0.9",
    "libphonenumber-js": "1.13.15",
    "mysql2": "3.24.6",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0"
  }
}
