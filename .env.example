# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models to try when the main one is overloaded (503/429) or times out.
# Pick names from: curl -s https://generativelanguage.googleapis.com/v1beta/models -H "x-goog-api-key: $KEY"
GEMINI_FALLBACK_MODELS=
# minimal | low | medium | high, or empty for the model default. Lower = faster replies.
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=20000

# --- WTT database (use the read-only wtt_bot user from sql/schema.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wtt_bot
DB_PASSWORD=
DB_NAME=h762997_wttsystemdk
# delivery.company / user.company value for WTT
COMPANY_ID=1

# --- Mapon ---
MAPON_API_KEY=
MAPON_CACHE_MINUTES=10
# Country for phone numbers stored without +prefix
DEFAULT_PHONE_COUNTRY=DK

# --- WhatsApp ---
WA_AUTH_DIR=./auth
BOT_TRIGGER=/bot
# Comma-separated group JIDs the bot answers in (empty = all groups it is in).
# The JID is logged when someone writes /bot in a group that is not listed.
ALLOWED_GROUPS=

# --- Limits ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MINUTES=10
HISTORY_TURNS=6
HISTORY_MAX_AGE_MINUTES=120

TIMEZONE=Europe/Copenhagen
LOG_LEVEL=info
